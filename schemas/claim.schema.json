{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/claim.schema.json",
  "title": "Satsuma step claim lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "vm_id", "step_id", "job_id", "session_id", "boot_id",
    "claimed_at", "claimed_unix_ms", "last_renewed_at", "last_renewed_unix_ms",
    "lease_expires_unix_ms", "renewal_sequence", "retry_safe", "attempt"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "run_id": {"type": "string", "minLength": 1},
    "vm_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "boot_id": {"type": "string", "minLength": 1},
    "claimed_at": {"type": "string", "format": "date-time"},
    "claimed_unix_ms": {"type": "integer", "minimum": 0},
    "last_renewed_at": {"type": "string", "format": "date-time"},
    "last_renewed_unix_ms": {"type": "integer", "minimum": 0},
    "lease_expires_unix_ms": {"type": "integer", "minimum": 0},
    "renewal_sequence": {"type": "integer", "minimum": 0},
    "retry_safe": {"type": "boolean"},
    "attempt": {"type": "integer", "minimum": 1}
  }
}
