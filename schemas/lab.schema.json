{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/lab.schema.json",
  "title": "Satsuma laboratory configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lab_id", "provider", "host", "shared_folder", "vms"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "lab_id": {"$ref": "#/$defs/identifier"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vmrun"],
      "properties": {
        "type": {"const": "vmware_workstation"},
        "vmrun": {"type": "string", "minLength": 1}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_root"],
      "properties": {
        "archive_root": {"type": "string", "minLength": 1}
      }
    },
    "shared_folder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_root"],
      "properties": {
        "host_root": {"type": "string", "minLength": 1}
      }
    },
    "vms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vmx", "agent_version", "snapshots"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "vmx": {"type": "string", "minLength": 1},
          "agent_version": {"type": "string", "minLength": 1},
          "snapshots": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base", "ai_prefix", "max_ai_snapshots"],
            "properties": {
              "base": {"type": "string", "minLength": 1, "maxLength": 128},
              "ai_prefix": {"$ref": "#/$defs/identifier"},
              "max_ai_snapshots": {"type": "integer", "minimum": 1, "maximum": 64}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  }
}
