{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/lab.schema.json",
  "title": "Satsuma laboratory configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lab_id", "provider", "host", "transport", "vms"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "lab_id": {"$ref": "#/$defs/identifier"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vmrun"],
      "properties": {
        "type": {"const": "vmware_workstation"},
        "vmrun": {"type": "string", "minLength": 1}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_root"],
      "properties": {
        "archive_root": {"type": "string", "minLength": 1}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_root", "vmci_port"],
      "properties": {
        "state_root": {"type": "string", "minLength": 1},
        "vmci_port": {"type": "integer", "minimum": 1, "maximum": 4294967294}
      }
    },
    "vms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vmx", "agent_version", "snapshots"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "hardware_id": {"$ref": "#/$defs/hardware_id"},
          "vmx": {"type": "string", "minLength": 1},
          "agent_version": {"type": "string", "minLength": 1},
          "agent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "snapshots": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base", "ai_prefix", "max_ai_snapshots"],
            "properties": {
              "base": {"type": "string", "minLength": 1, "maxLength": 128},
              "ai_prefix": {"$ref": "#/$defs/identifier"},
              "max_ai_snapshots": {"type": "integer", "minimum": 1, "maximum": 64}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "hardware_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
