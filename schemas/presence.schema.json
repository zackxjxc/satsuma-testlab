{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/presence.schema.json",
  "title": "Satsuma Agent presence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "lab_id", "vm_id", "hardware_id", "agent_version",
    "update_id", "session_id", "boot_id", "process_id", "status", "inventory", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "protocol_version": {"const": 4},
    "lab_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "vm_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "hardware_id": {"$ref": "#/$defs/hardware_id"},
    "agent_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "build_number": {"type": "string", "minLength": 1, "maxLength": 64},
    "build_attempt": {"type": "string", "minLength": 1, "maxLength": 64},
    "git_commit": {"type": "string", "minLength": 1, "maxLength": 64},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "update_id": {"type": "string", "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1},
    "boot_id": {"type": "string", "minLength": 1},
    "process_id": {"type": "integer", "minimum": 0},
    "status": {"enum": ["idle", "unbound"]},
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "sha256"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "vmci_channel_failure_count", "consecutive_vmci_channel_failures"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "vmci_channel_failure_count": {"type": "integer", "minimum": 0},
        "consecutive_vmci_channel_failures": {"type": "integer", "minimum": 0},
        "last_vmci_channel_error": {"type": "string", "maxLength": 1027},
        "last_vmci_channel_error_at": {"type": "string", "format": "date-time"},
        "last_vmci_channel_recovered_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "hardware_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
