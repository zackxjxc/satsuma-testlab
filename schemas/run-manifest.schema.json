{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/run-manifest.schema.json",
  "title": "Satsuma immutable run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "lab_id", "run_id", "request_id",
    "name", "created_at", "artifacts", "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"enum": [1, 2]},
    "lab_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256
    }
  },
  "allOf": [
    {
      "if": {"properties": {"protocol_version": {"const": 1}}},
      "then": {
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "oneOf": [
                {"$ref": "#/$defs/echo_step"},
                {"$ref": "#/$defs/execute_step_v1"}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "oneOf": [
                {"$ref": "#/$defs/echo_step"},
                {"$ref": "#/$defs/execute_step_v2"}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vm", "path", "sha256"],
      "properties": {
        "vm": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^artifacts[/\\\\].+"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "echo_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vm", "type", "timeout_seconds", "retry_safe", "message"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "vm": {"$ref": "#/$defs/identifier"},
        "type": {"const": "echo"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "retry_safe": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "execute_common": {
      "type": "object",
      "required": [
        "id", "vm", "type", "timeout_seconds", "retry_safe", "program",
        "arguments", "collect_files"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "vm": {"$ref": "#/$defs/identifier"},
        "type": {"const": "execute"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "retry_safe": {"type": "boolean"},
        "program": {"type": "string", "pattern": "^artifacts[/\\\\].+"},
        "arguments": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "string"}
        },
        "collect_files": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "execute_step_v1": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/execute_common"}
      ],
      "unevaluatedProperties": false
    },
    "execute_step_v2": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/execute_common"},
        {
          "type": "object",
          "required": ["run_as"],
          "properties": {"run_as": {"enum": ["system", "interactive_user"]}}
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
