{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/task.schema.json",
  "title": "Satsuma task plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "steps"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 3},
    "name": {"type": "string", "minLength": 1},
    "run_id": {"$ref": "#/$defs/identifier"},
    "artifacts": {
      "type": "array",
      "default": [],
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "vm", "destination"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "vm": {"$ref": "#/$defs/identifier"},
          "destination": {
            "type": "string",
            "pattern": "^artifacts[/\\\\].+"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vms"],
      "properties": {
        "vms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/vm_lifecycle"}
        },
        "finally": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/echo_step"},
              {"$ref": "#/$defs/execute_step"},
              {"$ref": "#/$defs/script_step"}
            ]
          }
        }
      }
    },
    "cleanup": {"$ref": "#/$defs/task_cleanup"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/echo_step"},
          {"$ref": "#/$defs/execute_step"},
          {"$ref": "#/$defs/script_step"}
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["lifecycle"]},
      "then": {"required": ["run_id"]}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "common_step": {
      "type": "object",
      "required": ["id", "vm", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "vm": {"$ref": "#/$defs/identifier"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "cleanup_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {"action": {"const": "leave_running"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {"action": {"const": "stop"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "snapshot"],
          "properties": {
            "action": {"const": "restore"},
            "snapshot": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      ]
    },
    "vm_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vm", "on_success", "on_failure"],
      "properties": {
        "vm": {"$ref": "#/$defs/identifier"},
        "restore_before": {"type": "string", "minLength": 1, "maxLength": 128},
        "on_success": {"$ref": "#/$defs/cleanup_policy"},
        "on_failure": {"$ref": "#/$defs/cleanup_policy"}
      }
    },
    "task_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guest_work", "host_run"],
      "properties": {
        "guest_work": {
          "type": "object",
          "additionalProperties": false,
          "required": ["on_success", "on_failure"],
          "properties": {
            "on_success": {"enum": ["delete", "retain"]},
            "on_failure": {"enum": ["delete", "retain"]}
          }
        },
        "host_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["on_success", "on_failure"],
          "properties": {
            "on_success": {"enum": ["retain", "archive_then_delete"]},
            "on_failure": {"enum": ["retain", "archive_then_delete"]}
          }
        }
      }
    },
    "echo_step": {
      "allOf": [
        {"$ref": "#/$defs/common_step"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "vm", "type", "message"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "vm": {"$ref": "#/$defs/identifier"},
            "type": {"const": "echo"},
            "message": {"type": "string", "minLength": 1},
            "retry_safe": {"type": "boolean"}
          }
        }
      ]
    },
    "execute_step": {
      "allOf": [
        {"$ref": "#/$defs/common_step"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "vm", "type", "program"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "vm": {"$ref": "#/$defs/identifier"},
            "type": {"const": "execute"},
            "program": {"type": "string", "pattern": "^artifacts[/\\\\].+"},
            "arguments": {
              "type": "array",
              "maxItems": 256,
              "items": {"type": "string"}
            },
            "run_as": {
              "enum": ["system", "interactive_user"],
              "default": "interactive_user"
            },
            "retry_safe": {"type": "boolean"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "collect_files": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "script_step": {
      "allOf": [
        {"$ref": "#/$defs/common_step"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "vm", "type", "engine", "script"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "vm": {"$ref": "#/$defs/identifier"},
            "type": {"const": "script"},
            "engine": {"enum": ["cmd", "windows_powershell", "pwsh"]},
            "script": {"type": "string", "pattern": "^artifacts[/\\\\].+"},
            "arguments": {
              "type": "array",
              "maxItems": 256,
              "items": {"type": "string"}
            },
            "run_as": {"enum": ["system", "interactive_user"], "default": "interactive_user"},
            "retry_safe": {"type": "boolean", "default": false},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "collect_files": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
