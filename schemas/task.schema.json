{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/task.schema.json",
  "title": "Satsuma task plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "steps"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "run_id": {"$ref": "#/$defs/identifier"},
    "artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "vm", "shared_destination"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "vm": {"$ref": "#/$defs/identifier"},
          "shared_destination": {
            "type": "string",
            "pattern": "^artifacts[/\\\\].+"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/echo_step"},
          {"$ref": "#/$defs/execute_step"}
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "common_step": {
      "type": "object",
      "required": ["id", "vm", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "vm": {"$ref": "#/$defs/identifier"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "echo_step": {
      "allOf": [
        {"$ref": "#/$defs/common_step"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "vm", "type", "message"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "vm": {"$ref": "#/$defs/identifier"},
            "type": {"const": "echo"},
            "message": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          }
        }
      ]
    },
    "execute_step": {
      "allOf": [
        {"$ref": "#/$defs/common_step"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "vm", "type", "program"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "vm": {"$ref": "#/$defs/identifier"},
            "type": {"const": "execute"},
            "program": {"type": "string", "pattern": "^artifacts[/\\\\].+"},
            "arguments": {"type": "array", "items": {"type": "string"}},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "collect_files": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  }
}
