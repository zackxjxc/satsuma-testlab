{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/update.schema.json",
  "title": "Satsuma Agent update manifest or result",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_version",
        "type",
        "lab_id",
        "vm_id",
        "update_id",
        "version",
        "binary",
        "size",
        "sha256",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "protocol_version": {"const": 1},
        "type": {"const": "update_agent"},
        "lab_id": {"$ref": "#/$defs/identifier"},
        "vm_id": {"$ref": "#/$defs/identifier"},
        "update_id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "binary": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "update_id",
        "vm_id",
        "version",
        "status",
        "rollback_status",
        "process_id",
        "error",
        "completed_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "update_id": {"$ref": "#/$defs/identifier"},
        "vm_id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"enum": ["succeeded", "failed"]},
        "rollback_status": {"enum": ["none", "succeeded", "failed"]},
        "process_id": {"type": "integer", "minimum": 0},
        "error": {"type": "string"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
