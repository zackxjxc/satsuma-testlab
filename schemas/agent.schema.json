{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satsuma.local/schemas/agent.schema.json",
  "title": "Satsuma VM Agent configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "lab_id",
    "agent_version",
    "transport",
    "storage_root",
    "local_work_root"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "protocol_version": {"const": 3},
    "lab_id": {"$ref": "#/$defs/identifier"},
    "vm_id": {"$ref": "#/$defs/identifier"},
    "agent_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "last_update_id": {"$ref": "#/$defs/identifier"},
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_cid", "vmci_port"],
      "properties": {
        "host_cid": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "vmci_port": {"type": "integer", "minimum": 1, "maximum": 4294967294},
        "request_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000}
      }
    },
    "storage_root": {"type": "string", "minLength": 1},
    "channel_root": {"type": "string", "minLength": 1},
    "local_work_root": {"type": "string", "minLength": 1},
    "poll_interval_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
    "reconnect_interval_ms": {"type": "integer", "minimum": 100, "maximum": 60000}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  }
}
